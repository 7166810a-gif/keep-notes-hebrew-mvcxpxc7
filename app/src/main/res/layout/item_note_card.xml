<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_wrapper"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_rounded"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Card Header Row (Folder Badge & Pin Status) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/item_folder_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:background="@drawable/bg_chip_normal"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textColor="#666666"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/item_pin_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentEnd="true"
            android:contentDescription="נעוץ"
            android:src="@drawable/ic_pinned"
            android:visibility="gone" />
    </RelativeLayout>

    <!-- Attached Image Thumbnail Preview -->
    <ImageView
        android:id="@+id/item_image_thumbnail"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginBottom="8dp"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- Note Title -->
    <TextView
        android:id="@+id/item_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#212121"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Note Body Snippet -->
    <TextView
        android:id="@+id/item_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="5"
        android:textColor="#555555"
        android:textSize="13sp" />

    <!-- Badges Row (Audio icon, checklist icon, date) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/item_badge_audio"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="הקלטה"
            android:src="@drawable/ic_mic"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/item_badge_checklist"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="משימות"
            android:src="@drawable/ic_check"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/item_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#9E9E9E"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
