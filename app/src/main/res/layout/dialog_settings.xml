<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textColor="#212121"
        android:textSize="18sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp"
        android:background="#EEEEEE" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ai_model_title"
        android:textColor="@color/primary_dark"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/ai_model_desc"
        android:textColor="#616161"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btn_pick_model"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_chip_normal"
        android:text="@string/choose_model_file"
        android:textColor="#333333"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tv_current_model"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="מודל נוכחי: מנוע קולי פנימי מקומי של המכשיר"
        android:textColor="#888888"
        android:textSize="11sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:background="#EEEEEE" />

    <Button
        android:id="@+id/btn_export_json"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_chip_normal"
        android:text="@string/export_data"
        android:textColor="#333333"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btn_import_json"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_chip_normal"
        android:text="@string/import_data"
        android:textColor="#333333"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btn_close_settings"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_chip_selected"
        android:text="@string/close"
        android:textColor="@color/primary_dark"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
