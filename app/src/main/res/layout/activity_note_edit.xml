<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/edit_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/note_color_white">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/edit_top_bar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="#05000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="חזרה"
            android:padding="8dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/tv_folder_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_chip_normal"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="@string/folder_personal"
            android:textColor="#616161"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btn_pin_note"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/pin"
            android:padding="8dp"
            android:src="@drawable/ic_pin" />

        <ImageView
            android:id="@+id/btn_color_picker"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="בחר צבע"
            android:padding="8dp"
            android:src="@drawable/ic_color" />

        <ImageView
            android:id="@+id/btn_delete_note"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/delete"
            android:padding="8dp"
            android:src="@drawable/ic_delete" />
    </LinearLayout>

    <!-- Note Content Scrollable Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/edit_bottom_tools"
        android:layout_below="@+id/edit_top_bar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="30dp">

            <!-- Attached Image Preview Container -->
            <FrameLayout
                android:id="@+id/image_preview_container"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iv_note_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/btn_remove_image"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:background="#AA000000"
                    android:padding="8dp"
                    android:src="@drawable/ic_delete" />
            </FrameLayout>

            <!-- Voice Recording Player Card -->
            <LinearLayout
                android:id="@+id/audio_player_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_card_rounded"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/btn_play_audio"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="6dp"
                    android:src="@drawable/ic_play" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_audio_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="הקלטה קולית שמורה"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_audio_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="לחצו לניגון שמע"
                        android:textColor="#757575"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btn_remove_audio"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="6dp"
                    android:src="@drawable/ic_delete" />
            </LinearLayout>

            <!-- Title Edit Field -->
            <EditText
                android:id="@+id/edit_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/note_title_hint"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:textColor="#1A1A1A"
                android:textColorHint="#9E9E9E"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Body / Note Text -->
            <EditText
                android:id="@+id/edit_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@null"
                android:gravity="top|start"
                android:hint="@string/note_body_hint"
                android:inputType="textMultiLine"
                android:lineSpacingExtra="4dp"
                android:minLines="6"
                android:textColor="#333333"
                android:textColorHint="#BDBDBD"
                android:textSize="16sp" />

            <!-- Checklist Container -->
            <LinearLayout
                android:id="@+id/checklist_items_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- Add Checklist Item Button -->
            <TextView
                android:id="@+id/btn_add_checklist_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:drawableStart="@drawable/ic_check"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:text="+ הוסף שורת משימה"
                android:textColor="@color/primary_dark"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Tools Bar -->
    <LinearLayout
        android:id="@+id/edit_bottom_tools"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:background="#FAFAFA"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btn_tool_checklist"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/add_checklist"
            android:padding="7dp"
            android:src="@drawable/ic_check" />

        <ImageView
            android:id="@+id/btn_tool_mic"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/record_audio"
            android:padding="7dp"
            android:src="@drawable/ic_mic" />

        <ImageView
            android:id="@+id/btn_tool_image"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/add_image"
            android:padding="7dp"
            android:src="@drawable/ic_image" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_last_edited"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="נערך כעת"
            android:textColor="#9E9E9E"
            android:textSize="12sp" />
    </LinearLayout>

</RelativeLayout>
